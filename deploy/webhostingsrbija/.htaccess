# CeroLeather — Apache / LiteSpeed configuration for a STATIC Angular build (prerendered pages)
# Upload next to index.html (public_html/ or the subdomain's folder). See deploy/webhostingsrbija/README.md.
# Every block is wrapped in <IfModule>, so a missing module never causes a "500 Internal Server Error".

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------------------------------------
# PREVIEW ONLY — keep the client preview out of Google. REMOVE this block for the final launch.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# ---------------------------------------------------------------------------------------------

# Serve /katalog as katalog/index.html directly (no 301 to /katalog/)
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Optional: force HTTPS once the SSL certificate is active (remove the two # below).
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1. Existing files (JS, CSS, images, GLB…) → as they are
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Home page
  RewriteRule ^$ index.html [L]

  # 3. Prerendered pages: /katalog, /katalog/prsluk-kosmaj, /o-nama, /porudzbina (with or without /)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # 4. Anything else that is not a file request → the client-side app
  #    (Angular shows its own "Stranica nije pronađena" page). Missing images/scripts stay real 404s.
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^ index.csr.html [L]
</IfModule>

# Correct types (the GLB model and the web manifest are often unknown to shared hosts)
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

# Compression for text files (images, video and GLB are already compressed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>

# Caching
#  - index.html files: always revalidated, so every new upload is visible immediately
#  - main-*.js / chunk-*.js / styles-*.css: file names change on every build → cache for a year
#  - images / GLB / icons: 1 day during the preview phase (files keep their names between uploads)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(main|chunk|styles|polyfills)-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|ico|svg|glb|mp4|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
